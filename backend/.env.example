PORT_HTTP=4000
PORT_HTTPS=4443
# ต้องเป็นค่าสุ่มยาว >= 16 ตัว (แนะนำ 32+) ห้ามใช้ค่าตัวอย่างนี้ในโปรดักชัน
# สร้างด้วย:  openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=12h

# โดเมนที่อนุญาตให้เรียก API ข้าม origin (คั่นด้วย ,) เว้นว่างได้ถ้า frontend เสิร์ฟจากเซิร์ฟเวอร์เดียวกัน
CORS_ORIGIN=https://champ-powerspk.com,https://www.champ-powerspk.com

# ตั้งค่าเชื่อมต่อ MySQL ของ XAMPP (ค่าเริ่มต้นของ XAMPP คือ user root ไม่มีรหัสผ่าน พอร์ต 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_system

# LINE Messaging API (บอทอ่านข้อความ "คิว..." จากไลน์กลุ่ม แล้วสร้างใบเสนอราคาอัตโนมัติ)
# เอาจาก https://developers.line.biz/console/ → channel ของร้าน
#   Channel secret       : แท็บ Basic settings
#   Channel access token : แท็บ Messaging API (กด Issue)
# เว้นว่างทั้งคู่ = ปิดฟีเจอร์นี้ (webhook จะตอบ 503)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
