PORT_HTTP=4000
PORT_HTTPS=4443
# ต้องเป็นค่าสุ่มยาว >= 16 ตัว (แนะนำ 32+) ห้ามใช้ค่าตัวอย่างนี้ในโปรดักชัน
# สร้างด้วย:  openssl rand -hex 32
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=12h

# โดเมนที่อนุญาตให้เรียก API ข้าม origin (คั่นด้วย ,) เว้นว่างได้ถ้า frontend เสิร์ฟจากเซิร์ฟเวอร์เดียวกัน
CORS_ORIGIN=https://champ-powerspk.com,https://www.champ-powerspk.com

# ตั้งค่าเชื่อมต่อ MySQL ของ XAMPP (ค่าเริ่มต้นของ XAMPP คือ user root ไม่มีรหัสผ่าน พอร์ต 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_system

# LINE Messaging API (บอทอ่านข้อความ "คิว..." จากไลน์กลุ่ม แล้วสร้างใบเสนอราคาอัตโนมัติ)
# เอาจาก https://developers.line.biz/console/ → channel ของร้าน
#   Channel secret       : แท็บ Basic settings
#   Channel access token : แท็บ Messaging API (กด Issue)
# เว้นว่างทั้งคู่ = ปิดฟีเจอร์นี้ (webhook จะตอบ 503)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# บอท 2 "Champpower รับรายการ" และบอท 3 "Champpower ปิดบิล" — คนละ Official Account
# กับบอท 1 ด้านบน (แยก Channel Secret/Token ของตัวเอง) endpoint อยู่ที่
# /api/line/bot2/webhook และ /api/line/bot3/webhook ตามลำดับ ยังไม่มี business logic
# จริง (แค่ตรวจลายเซ็น + จับ group id ไว้ก่อน) เว้นว่าง = ปิดฟีเจอร์เหมือนบอท 1
LINE_BOT2_CHANNEL_SECRET=
LINE_BOT2_CHANNEL_ACCESS_TOKEN=
LINE_BOT3_CHANNEL_SECRET=
LINE_BOT3_CHANNEL_ACCESS_TOKEN=

# เชื่อมอ่านค่าใช้จ่ายจากโปรแกรมบัญชี (champ-accounting) เพื่อแสดงในหน้าเจ้าของ — อ่านอย่างเดียว
# สร้าง MySQL user แยกที่มีสิทธิ์ SELECT เฉพาะตาราง entries กับ categories ของฐานข้อมูลบัญชี เช่น
#   CREATE USER 'stock_acc_ro'@'localhost' IDENTIFIED BY '<รหัสผ่านสุ่ม>';
#   GRANT SELECT ON champ_accounting.entries TO 'stock_acc_ro'@'localhost';
#   GRANT SELECT ON champ_accounting.categories TO 'stock_acc_ro'@'localhost';
# แล้วใส่ชื่อและรหัสผ่านด้านล่าง เว้น ACCOUNTING_DB_USER ว่าง = ปิดการเชื่อม (หน้าเจ้าของแค่ไม่แสดงค่าใช้จ่าย)
ACCOUNTING_DB_USER=
ACCOUNTING_DB_PASSWORD=
ACCOUNTING_DB_NAME=champ_accounting
